{
  "name": "rebugger",
  "version": "0.5.0",
  "private": true,
  "description": "A console and on-page debugger for the Scratch player: read and write variables, freeze, scan, savestates, record, speed and pause",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "test": "node build.js && node --test tests/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "scratch-vm": "^5.0.300"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
